---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
    title: string;
    description: string;
    image?: string;
    current?: string;
    robots?: string;
}
const {title, description, current, image, robots} = Astro.props;
---
<html lang="en">
<head>
    <script is:inline>
        (function () {
            const KEY = 'jetexir-theme';

            function storedTheme() {
                try {
                    const value = localStorage.getItem(KEY);
                    if (value === 'light' || value === 'dark') return value;
                } catch (e) {
                    // Storage unavailable (e.g. private mode), fall through.
                }
                return null;
            }

            function syncThemeColor(theme) {
                const meta = document.querySelector('meta[name="theme-color"]');
                if (meta) {
                    meta.setAttribute('content', theme === 'dark' ? '#12141d' : '#FFFFFF');
                }
            }

            function currentTheme() {
                // A manually chosen theme wins; otherwise follow the device.
                return storedTheme() || (
                    window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
                            ? 'dark'
                            : 'light'
                );
            }

            function applyTheme() {
                const theme = currentTheme();
                document.documentElement.setAttribute('data-theme', theme);
                syncThemeColor(theme);
            }

            applyTheme();

            // Re-apply theme after every View Transition navigation.
            // astro:after-swap fires immediately after the new DOM is attached
            // (prevents flash of wrong theme). astro:page-load is a safety net.
            document.addEventListener('astro:after-swap', applyTheme);
            document.addEventListener('astro:page-load', applyTheme);
        })();
    </script>
    <BaseHead title={title} description={description} image={image} robots={robots} />
</head>
<body>
    <Header current={current} />
    <main>
        <slot />
    </main>
    <Footer />

    <style is:global>
        :root {
            --background: #ffffff;
            --footer-bg: #23282d;
            --card-bg: #ffffff;
            --border: #e5e7eb;
            --text: #18181b;
            --text-muted: #52525b;
            --text-dim: #9ca3af;
            --text-white: #fff;
            --footer-link: rgb(180, 180, 190);
            --footer-link-hover: rgb(255, 255, 255);
            --primary: #23282d;
            --secondary: #23282d;
            --pink: #d946ef;
            --success: #16a34a;
            --gradient: linear-gradient(135deg, #23282d 0%, #3c434a 100%);
            --icon-bg: rgba(35, 40, 45, 0.1);
            --header-bg: rgba(255, 255, 255, 0.85);
            --header-height: 68px;
            --radius: 16px;
        }

        html[data-theme="dark"] {
            color-scheme: dark;
            --background: #12141d;
            --card-bg: #1a1d28;
            --border: #2b2f40;
            --text: #ececf1;
            --text-muted: #a6aabb;
            --text-dim: #6d7283;
            --icon-bg: rgba(255, 255, 255, 0.06);
            --header-bg: rgba(18, 20, 29, 0.85);
            --footer-bg: #23282d;
        }

        html[data-theme="dark"] body {
            background-color: var(--background);
            color: var(--text);
        }

        html[data-theme="dark"] .btn-ghost {
            color: var(--text);
            border-color: var(--border);
        }

        html[data-theme="dark"] .btn-ghost:hover,
        html[data-theme="dark"] .btn-ghost:focus {
            color: var(--text);
        }

        html[data-theme="dark"] .hero-badge {
            background: rgba(255, 255, 255, 0.06);
        }

        /* Preview element dark mode overrides */
        html[data-theme="dark"] .preview-header {
            background: var(--card-bg);
            border-bottom-color: var(--border);
        }

        html[data-theme="dark"] .preview-title {
            color: var(--text-muted);
        }

        html[data-theme="dark"] .preview-badge {
            background: rgba(255, 255, 255, 0.06);
            color: var(--text-dim);
        }

        html[data-theme="dark"] .preview-empty {
            color: var(--text-dim);
        }

        /* Prose/content headings */
        html[data-theme="dark"] .prose h1,
        html[data-theme="dark"] .prose h2,
        html[data-theme="dark"] .prose h3,
        html[data-theme="dark"] .prose h4,
        html[data-theme="dark"] .prose strong,
        html[data-theme="dark"] .content h1,
        html[data-theme="dark"] .content h2,
        html[data-theme="dark"] .content h3,
        html[data-theme="dark"] .content h4,
        html[data-theme="dark"] .content strong {
            color: var(--text);
        }

        /* Prose/content paragraphs */
        html[data-theme="dark"] .prose p,
        html[data-theme="dark"] .prose li,
        html[data-theme="dark"] .content p,
        html[data-theme="dark"] .content li {
            color: var(--text-muted);
        }

        /* Prose/content links */
        html[data-theme="dark"] .prose a:not(.btn),
        html[data-theme="dark"] .content a:not(.btn) {
            color: #5b8def;
        }

        /* Prose/content blockquotes */
        html[data-theme="dark"] .prose blockquote,
        html[data-theme="dark"] .content blockquote {
            background: var(--card-bg);
            border-left-color: var(--border);
        }

        html[data-theme="dark"] .prose blockquote p,
        html[data-theme="dark"] .content blockquote p {
            color: var(--text-muted);
        }

        /* --- WordPress plugin preview dark mode --- */

        /* Plugin page base */
        html[data-theme="dark"] .wp-plugin-page {
            color: var(--text);
        }

        /* Plugin header */
        html[data-theme="dark"] .wp-plugin-name {
            color: var(--text);
        }

        html[data-theme="dark"] .wp-plugin-author {
            color: var(--text-dim);
        }

        html[data-theme="dark"] .wp-plugin-author a {
            color: #5b8def;
        }

        html[data-theme="dark"] .wp-plugin-icon {
            background: rgba(255,255,255,0.06);
            border-color: var(--border);
        }

        html[data-theme="dark"] .wp-plugin-icon svg {
            stroke: #5b8def;
        }

        html[data-theme="dark"] .wp-heart-btn {
            background: rgba(255,255,255,0.06);
            border-color: var(--border);
            color: var(--text-dim);
        }

        html[data-theme="dark"] .wp-heart-btn:hover {
            border-color: #5b8def;
            color: #5b8def;
        }

        /* Tab nav */
        html[data-theme="dark"] .wp-tab-nav {
            border-bottom-color: var(--border);
        }

        html[data-theme="dark"] .wp-tab-nav hr {
            border-color: var(--border);
        }

        html[data-theme="dark"] .wp-tab-btn {
            color: var(--text-dim);
        }

        html[data-theme="dark"] .wp-tab-btn:hover {
            color: var(--text);
            background: rgba(255,255,255,0.06);
        }

        html[data-theme="dark"] .wp-tab-btn.is-active {
            color: var(--text);
            background: var(--background);
            border-color: var(--border);
            border-bottom-color: var(--background);
        }

        /* Body grid */
        html[data-theme="dark"] .wp-body {
            /* grid layout preserved */
        }

        /* Content headings */
        html[data-theme="dark"] .wp-content-title,
        html[data-theme="dark"] .wp-block-title,
        html[data-theme="dark"] .wp-prose h1,
        html[data-theme="dark"] .wp-prose h2,
        html[data-theme="dark"] .wp-prose h3,
        html[data-theme="dark"] .wp-prose h4,
        html[data-theme="dark"] .wp-prose strong {
            color: var(--text);
        }

        /* Content text */
        html[data-theme="dark"] .wp-prose p,
        html[data-theme="dark"] .wp-prose li {
            color: var(--text-muted);
        }

        /* Content links */
        html[data-theme="dark"] .wp-prose a:not(.btn) {
            color: #5b8def;
        }

        html[data-theme="dark"] .wp-prose a:not(.btn):hover {
            color: #7ba3f7;
        }

        /* Content code */
        html[data-theme="dark"] .wp-prose code {
            background: rgba(255,255,255,0.06);
            color: var(--text);
        }

        html[data-theme="dark"] .wp-prose pre {
            background: rgba(255,255,255,0.04);
            border-color: var(--border);
        }

        html[data-theme="dark"] .wp-prose blockquote {
            background: var(--card-bg);
            border-left-color: #5b8def;
        }

        html[data-theme="dark"] .wp-prose blockquote p {
            color: var(--text-muted);
        }

        html[data-theme="dark"] .wp-prose hr {
            border-top-color: var(--border);
        }

        /* FAQ */
        html[data-theme="dark"] .wp-faq-item {
            border-bottom-color: var(--border);
        }

        html[data-theme="dark"] .wp-faq-q {
            color: #5b8def;
        }

        html[data-theme="dark"] .wp-faq-q:hover {
            color: #7ba3f7;
        }

        html[data-theme="dark"] .wp-faq-a {
            color: var(--text-muted);
        }

        /* Screenshots */
        html[data-theme="dark"] .wp-screenshot-img {
            background: rgba(255,255,255,0.04);
            border-color: var(--border);
        }

        /* Sidebar */
        html[data-theme="dark"] .wp-sidebar-th {
            color: var(--text);
        }

        html[data-theme="dark"] .wp-sidebar-td {
            color: var(--text);
        }

        html[data-theme="dark"] .wp-sidebar-row {
            border-bottom-color: var(--border);
        }

        html[data-theme="dark"] .wp-sidebar-heading {
            color: var(--text);
        }

        html[data-theme="dark"] .wp-sidebar-link {
            color: #5b8def;
        }

        html[data-theme="dark"] .wp-sidebar-tags-row {
            /* no border */
        }

        html[data-theme="dark"] .wp-sidebar-tags-label {
            color: var(--text);
        }

        html[data-theme="dark"] .wp-tag {
            background: rgba(255,255,255,0.06);
            border-color: var(--border);
            color: var(--text-muted);
        }

        html[data-theme="dark"] .wp-advanced-view {
            color: #5b8def;
        }

        html[data-theme="dark"] .wp-support-link {
            color: #5b8def;
        }

        html[data-theme="dark"] .wp-rating-text,
        html[data-theme="dark"] .wp-support-text {
            color: var(--text-dim);
        }

        html[data-theme="dark"] .wp-support-link-block a {
            color: #5b8def;
        }

        /* Reviews */
        html[data-theme="dark"] .wp-review-item {
            border-bottom-color: var(--border);
        }

        html[data-theme="dark"] .wp-review-title {
            color: #5b8def;
        }

        html[data-theme="dark"] .wp-review-meta {
            color: var(--text-dim);
        }

        html[data-theme="dark"] .wp-review-text {
            color: var(--text-muted);
        }

        /* Contributors */
        html[data-theme="dark"] .wp-contributor-name {
            color: #5b8def;
        }

        /* Empty / error messages */
        html[data-theme="dark"] .wp-empty-msg {
            color: var(--text-dim);
        }

        /* Rating bars */
        html[data-theme="dark"] .wp-rating-bar {
            background: rgba(255,255,255,0.1);
        }

        html[data-theme="dark"] .wp-rating-score {
            color: var(--text-dim);
        }

        html[data-theme="dark"] .wp-rating-label {
            color: #5b8def;
        }

        html[data-theme="dark"] .wp-rating-count {
            color: #5b8def;
        }

        html[data-theme="dark"] .wp-rating-link {
            color: #5b8def;
        }

        html[data-theme="dark"] .wp-dev-text {
            color: var(--text-muted);
        }

        html[data-theme="dark"] .wp-dev-text a {
            color: #5b8def;
        }

        html[data-theme="dark"] .wp-dev-subtitle {
            color: var(--text);
        }

        /* Maximize button dark mode */
        html[data-theme="dark"] .maximize-btn {
            color: var(--text-dim);
            border-color: var(--border);
        }

        html[data-theme="dark"] .maximize-btn:hover {
            color: #5b8def;
            border-color: #5b8def;
            background: rgba(255,255,255,0.08);
        }

        /* Editor toolbar buttons (upload, example, download, clear) dark mode */
        html[data-theme="dark"] .upload-btn,
        html[data-theme="dark"] .example-btn,
        html[data-theme="dark"] .download-btn,
        html[data-theme="dark"] .clear-btn {
            color: var(--text-dim);
            border-color: var(--border);
        }

        html[data-theme="dark"] .upload-btn:hover,
        html[data-theme="dark"] .example-btn:hover,
        html[data-theme="dark"] .download-btn:hover,
        html[data-theme="dark"] .clear-btn:hover {
            color: #5b8def;
            border-color: #5b8def;
            background: rgba(255,255,255,0.08);
        }

        /* Validator dark mode */
        html[data-theme="dark"] .validator-toggle {
            color: var(--text-dim);
            border-color: var(--border);
        }
        html[data-theme="dark"] .validator-toggle:hover {
            color: #5b8def;
            border-color: #5b8def;
            background: rgba(255,255,255,0.08);
        }
        html[data-theme="dark"] .validator-toggle.active {
            color: #4ade80;
            border-color: #4ade80;
            background: rgba(74,222,128,0.1);
        }
        html[data-theme="dark"] .validator-toggle.has-errors {
            color: #f87171;
            border-color: #f87171;
            background: rgba(248,113,113,0.1);
        }
        html[data-theme="dark"] .validator-toggle.has-warnings {
            color: #fbbf24;
            border-color: #fbbf24;
            background: rgba(251,191,36,0.1);
        }
        html[data-theme="dark"] .validator-panel {
            background: var(--card-bg);
            border-top-color: var(--border);
        }
        html[data-theme="dark"] .validator-header {
            border-bottom-color: var(--border);
        }
        html[data-theme="dark"] .ring-bg {
            stroke: var(--border);
        }
        html[data-theme="dark"] .check-item {
            border-bottom-color: var(--border);
        }
        html[data-theme="dark"] .check-icon.pass {
            background: rgba(22,163,74,0.2);
            color: #4ade80;
        }
        html[data-theme="dark"] .check-icon.fail {
            background: rgba(214,54,56,0.2);
            color: #f87171;
        }
        html[data-theme="dark"] .check-icon.warn {
            background: rgba(219,166,23,0.2);
            color: #fbbf24;
        }
        html[data-theme="dark"] .check-icon.info {
            background: rgba(67,56,202,0.2);
            color: #818cf8;
        }
        html[data-theme="dark"] .check-tip {
            background: rgba(56,89,233,0.1);
            border-left-color: #5b8def;
            color: var(--text-muted);
        }
        html[data-theme="dark"] .check-tip svg {
            color: #5b8def;
        }
        html[data-theme="dark"] .check-group-count {
            background: rgba(255,255,255,0.06);
        }

        /* Theme toggle dark mode */
        html[data-theme="dark"] .theme-toggle {
            color: var(--text-dim);
            border-color: var(--border);
        }

        html[data-theme="dark"] .theme-toggle:hover {
            color: #5b8def;
            border-color: #5b8def;
            background: rgba(255,255,255,0.08);
        }

        /* Copy button (donate page) dark mode */
        html[data-theme="dark"] .copy-btn {
            color: var(--text-dim);
            border-color: var(--border);
        }

        html[data-theme="dark"] .copy-btn:hover {
            color: #5b8def;
            border-color: #5b8def;
            background: rgba(255,255,255,0.08);
        }

        html[data-theme="dark"] .copy-btn.copied {
            border-color: var(--success);
            color: var(--success);
            background: rgba(22,163,74,0.15);
        }

        /* Resize handle dark mode */
        html[data-theme="dark"] .resize-handle {
            background: var(--border);
        }

        html[data-theme="dark"] .resize-handle:hover,
        html[data-theme="dark"] .resize-handle.drag {
            background: #5b8def;
        }

        html[data-theme="dark"] .resize-dots {
            background-image: radial-gradient(circle, var(--text-dim) 1px, transparent 1px);
        }

        /* Donate page dark mode */
        html[data-theme="dark"] .section-kicker {
            color: #5b8def;
        }

        html[data-theme="dark"] .crypto-card:hover {
            border-color: #5b8def;
        }



        html[data-theme="dark"] .crypto-card {
            background: var(--card-bg);
            border-color: var(--border);
        }
    </style>
</body>
</html>
