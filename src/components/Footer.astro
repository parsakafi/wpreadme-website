---
import {SITE_TITLE} from '../consts';
---

<footer class="site-footer">
    <div class="container">
        <div class="footer-top">
            <div>
                <p class="footer-brand">{SITE_TITLE}</p>
                <p class="footer-tagline">
                    A free online tool to preview your WordPress plugin readme.txt file before publishing.
                </p>
            </div>

            <nav class="footer-nav" aria-label="Footer navigation">
                <ul>
                    <li><a href="/about" data-astro-prefetch>About</a></li>
                    <li><a href="/donate" data-astro-prefetch>Donate</a></li>
                </ul>
            </nav>

            <div class="footer-links">
                <a href="https://developer.wordpress.org/plugins/wordpress-org/plugin-developer-faq/" target="_blank"
                   rel="noopener">Plugin Developer FAQ</a>
                <a href="https://developer.wordpress.org/plugins/wordpress-org/how-your-readme-txt-works/"
                   target="_blank" rel="noopener">Readme Format Docs</a>
                <a href="https://developer.wordpress.org/plugins/wordpress-org/plugin-assets/" target="_blank"
                   rel="noopener">How Your Plugin Assets Work</a>
                <a href="https://wordpress.org/plugins/developers/add/" target="_blank" rel="noopener">Add Your
                    Plugin</a>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© {new Date().getFullYear()} {SITE_TITLE}. All rights reserved.</p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        background: var(--footer-bg, #23282d);
        padding: 3.5rem 0 1.5rem;
        margin-top: 4rem;
    }

    .site-footer a {
        color: var(--footer-link);
    }

    .site-footer a:hover {
        color: var(--footer-link-hover);
    }

    .footer-top {
        display: grid;
        grid-template-columns: 1.6fr 0.7fr 0.7fr;
        gap: 2.5rem;
        padding-bottom: 2.5rem;
    }

    .footer-brand {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--text-white);
        margin: 0 0 0.4rem;
    }

    .fw-light {
        font-weight: 400;
        color: var(--text-dim);
    }

    .footer-tagline {
        color: var(--text-dim);
        font-size: 0.92rem;
        max-width: 34rem;
        line-height: 1.7;
    }

    .footer-nav ul,
    .footer-links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .footer-nav li {
        margin: 0;
    }

    .footer-nav a,
    .footer-links a {
        font-size: 0.95rem;
        transition: color 0.2s ease;
    }

    .footer-links {
        display: flex;
        flex-direction: column;
        text-align: left;
    }

    .footer-bottom {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid rgb(40, 32, 69);
        padding-top: 1.25rem;
    }

    .footer-bottom p {
        color: var(--text-dim);
        font-size: 0.85rem;
        margin: 0;
    }

    @media (max-width: 820px) {
        .footer-top {
            grid-template-columns: 1fr;
            gap: 1.75rem;
        }

        .footer-bottom {
            flex-direction: column;
        }
    }
</style>