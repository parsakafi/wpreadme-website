---
import {Icon} from "astro-icon/components";

interface Props {
    title?: string;
    text?: string;
}

const {
    title = 'Enjoying WPReadme Preview?',
    text = 'This tool is free to use. If you find it helpful for your WordPress plugin development, consider supporting its continued development and maintenance.',
} = Astro.props;
---

<section class="cta-section">
    <div class="container cta-container">
        <div class="cta-content">
            <h2 class="cta-title">{title}</h2>
            <p class="cta-text">{text}</p>
        </div>
        <a href="/donate" class="cta-button">
            <Icon name="heart" height="20" width="20"/>
            <span>Support the Project</span>
        </a>
    </div>
</section>

<style>
    .cta-section {
        padding: 3rem 0 4.5rem;
        margin-inline: 0.75rem;
    }

    .cta-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 2.5rem 3rem;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 16px;
    }

    .cta-title {
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0 0 0.5rem;
        color: var(--text);
    }

    .cta-text {
        font-size: 0.95rem;
        color: var(--text-muted);
        line-height: 1.65;
        margin: 0;
        max-width: 32rem;
    }

    .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.85rem 1.6rem;
        border-radius: 10px;
        background: var(--accent-donate);
        color: #fff;
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
        transition: background 0.2s, transform 0.15s;
    }

    .cta-button:hover {
        background: var(--accent-donate-hover);
        color: #fff;
        transform: translateY(-1px);
    }

    @media (max-width: 640px) {
        .cta-container {
            flex-direction: column;
            text-align: center;
            padding: 2rem 1.5rem;
        }

        .cta-text {
            max-width: 100%;
        }
    }
</style>
